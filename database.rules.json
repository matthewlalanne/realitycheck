// Outlast Realtime Database rules.
//
// Access requires a signed-in session: the app and the website both exchange
// the shared league passphrase for a Firebase token (see the leagueSignIn
// function), and everything here is gated on that. Without it the record is
// not readable at all, which is the whole point — before this, anyone with
// the database URL could read the league.
//
// On top of that, these rules protect INTEGRITY: the record, the leagues, the
// rosters and the cast cannot be deleted or replaced with junk, and every
// value has to be the right shape and size.
//
// Deletion is blocked with .validate on the PARENT rather than .write on the
// child: RTDB skips validate rules when a value is set to null, but the
// parent's own new value is still non-null, so its validate runs and can
// insist the child is still there. Writes stay granted at the top and cascade
// down from there.
//
// A WARNING for anyone adding a rule below, learned the hard way. These run
// against everything a write carries, not only the part that changed, and a
// transaction carries its whole subtree. So a value that breaks one rule here
// does not just fail its own write — it fails every later write that includes
// it, in branches that have nothing to do with it. One chat message over the
// 1000-character limit once stopped the Denver draft outright, because the
// draft transaction ran on the record root and swept chat along with it.
//
// Two things keep that from recurring, and both need to stay true:
//   1. The draft transaction runs on league/leagues/$lg, NOT the root
//      (sync.js _draftLeagueRef, and the app's lib/state.ts draftLeaguePath).
//      Do not widen it back.
// A GIF message carries no words, so `text` is allowed to be empty when a
// `gif` child is present — and only then. Anything that renders a message has
// to cope with both shapes: the app's MessagesScreen, app.js on the website,
// and the push notification in functions/index.js.
//
//   2. Every limit here has a matching cap on the inputs, in the app's
//      lib/limits.ts and in app.js's LIMITS. Change a number here, change it
//      in both — otherwise the UI lets someone type a value the database will
//      refuse, and it lands in the record as the next landmine.
// The same reasoning is why `draftBoards` (each person's private pre-draft
// ranking and notes) is a top-level node rather than living under `league`:
// a note is free text typed on draft night, and inside the league record it
// would be swept into the next pick's transaction exactly like that chat
// message was. Out here, a bad note can only fail its own write.
// `recapDrafts` sits out here for the same reason, and so nothing in it is
// visible in the app until the commissioner loads it into the episode editor
// and publishes: it's what the weekly recap task writes (via admin), holding
// Claude's draft recap and stats for an episode, plus the commissioner's own
// saved work in progress (`editor`, from the editor's Save draft button).
//
// `node "Survivor League/check-record.mjs"` audits the live record against
// these rules; run it before draft night.
{
  "rules": {
    "authCodes": {
      // Server (Cloud Functions, admin) only. Clients never read or write
      // sign-in codes directly.
      ".read": false,
      ".write": false
    },
    "league": {
      // Outlast's original single-season record, copied in once. Read-only
      // now; the migration script moves it into seasons/survivor-51.
      ".read": "auth != null",
      ".write": false
    },
    "seasons": {
      // One record per show season: cast, schedule, results, and the leagues
      // playing it. Results are entered once, by an admin, for every league.
      ".read": "auth != null",
      "$season": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "leagues": {
          "$lg": {
            // Members play their own league (picks, draft, settings). Leagues are
            // created and joined only through Cloud Functions, which bypass these.
            ".write": "auth != null && data.child('memberIds').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'players'])",
            "memberIds": {
              "$uid": { ".validate": "data.exists() && newData.val() === data.val()" }
            },
            "commissionerIds": {
              "$i": { ".validate": "data.exists() && newData.val() === data.val()" }
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "picksPerPlayer": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
            },
            "players": {
              ".validate": "newData.hasChildren()",
              "$i": {
                ".validate": "newData.hasChildren(['id', 'name'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().length <= 60"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
                },
                "members": {
                  "$m": {
                    ".validate": "newData.hasChildren(['id', 'name'])",
                    "id": {
                      ".validate": "newData.isString() && newData.val().length <= 60"
                    },
                    "name": {
                      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
                    },
                    "$other": {
                      ".validate": false
                    }
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "picks": {
              "$contestantId": {
                "$owner": {
                  ".validate": "newData.isString() && newData.val().length <= 60"
                }
              }
            },
            "pickOrder": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              }
            },
            "castPhotos": {
              "$contestantId": {
                ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 120000"
              }
            },
            "puzzleImage": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 200000"
            },
            "castBios": {
              // Commissioner-written bios (app/lib/castBios.ts). Caps match LIMITS.
              "$contestantId": {
                "hometown": { ".validate": "newData.isString() && newData.val().length <= 100" },
                "occupation": { ".validate": "newData.isString() && newData.val().length <= 100" },
                "about": { ".validate": "newData.isString() && newData.val().length <= 2000" },
                "$other": { ".validate": false }
              }
            }
          }
        },
        "contestants": {
          ".validate": "newData.hasChildren()",
          "$i": {
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "eliminatedWeek": {
              ".validate": "newData.isNumber() || newData.val() == null"
            },
            "exitReason": {
              ".validate": "newData.val() === 'voted' || newData.val() === 'quit'"
            },
            "tribe": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "items": {
              "$itemId": {
                ".validate": "$itemId.length <= 40 && newData.hasChildren(['kind', 'ep'])",
                "kind": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
                },
                "ep": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "episodeTitles": {
          "$ep": {
            ".validate": "$ep.length <= 3 && newData.isString() && newData.val().length <= 80"
          }
        },
        "episodeStats": {
          "$ep": {
            ".validate": "$ep.length <= 3",
            "$cid": {
              ".validate": "$cid.length <= 60",
              "immunity": { ".validate": "newData.isBoolean()" },
              "reward": { ".validate": "newData.isBoolean()" },
              "journey": { ".validate": "newData.isBoolean()" },
              "idolFound": { ".validate": "newData.isBoolean()" },
              "idolPlay": { ".validate": "newData.val() === 'saved' || newData.val() === 'wasted'" },
              "votes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
              "$other": { ".validate": false }
            }
          }
        },
        "game": {
          "mergeEp": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40" },
          "juryEp": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40" },
          "$other": { ".validate": false }
        },
        "tribes": {
          "$tribeId": {
            ".validate": "$tribeId.length <= 60 && newData.hasChildren(['name', 'color'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "messages": {
          "$lg": {
            ".write": "auth != null && root.child('seasons').child($season).child('leagues').child($lg).child('memberIds').child(auth.uid).exists()",
            "$id": {
              ".validate": "newData.hasChildren(['authorId', 'text', 'createdAt'])",
              "authorId": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "authorName": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 1000 && (newData.val().length > 0 || newData.parent().child('gif').exists())"
              },
              "gif": {
                ".validate": "newData.hasChildren(['url'])",
                "url": {
                  ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500"
                },
                "preview": {
                  ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500"
                },
                "width": { ".validate": "newData.isNumber()" },
                "height": { ".validate": "newData.isNumber()" },
                "title": { ".validate": "newData.isString() && newData.val().length <= 100" },
                "$other": { ".validate": false }
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "reactions": {
                "$emoji": {
                  ".validate": "$emoji.length <= 16",
                  "$playerId": {
                    ".validate": "newData.isBoolean()"
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "predictions": {
          "$lg": {
            ".write": "auth != null && root.child('seasons').child($season).child('leagues').child($lg).child('memberIds').child(auth.uid).exists()",
            "$ep": {
              "$playerId": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              }
            }
          }
        },
        "winnerPicks": {
          "$lg": {
            ".write": "auth != null && root.child('seasons').child($season).child('leagues').child($lg).child('memberIds').child(auth.uid).exists()",
            "$playerId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            }
          }
        },
        "episodeNotes": {
          "$week": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          }
        },
        "announcements": {
          "$id": {
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "week": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "season": {
          ".validate": "newData.isNumber()"
        },
        "week": {
          ".validate": "newData.isNumber()"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "draftPractice": {
          ".validate": "newData.isBoolean()"
        },
        "puzzleScores": { ".write": "auth != null" },
        "memoryScores": { ".write": "auth != null" }
      }
    },
    "seasonCatalog": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "photo": { ".validate": "newData.isString() && newData.val().length < 120000" },
        "$other": { ".validate": false }
      }
    },
    "userLeagues": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "inviteCodes": { ".read": false, ".write": false },
    "rehearsal": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['leagues', 'contestants'])"
    },
    "avatars": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 120000"
      }
    },
    "typing": {
      ".read": "auth != null",
      "$lg": {
        "$personId": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        }
      }
    },
    "reads": {
      ".read": "auth != null",
      "$lg": {
        "$personId": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        }
      }
    },
    "pushTokens": {
      "$entryId": {
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChildren(['token', 'playerId'])",
        "token": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "playerId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "leagueKey": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "playerName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "platform": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gifCache": {
      ".read": false,
      ".write": false
    },
    "recapDrafts": {
      ".read": "auth != null",
      "$ep": {
        ".write": "auth != null",
        ".validate": "$ep.length <= 3 && (newData.hasChildren(['recap', 'stats', 'createdAt']) || newData.hasChild('editor'))",
        "recap": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },
    "draftBoards": {
      ".read": "auth != null",
      "$lg": {
        "$personId": {
          ".write": "auth != null",
          "order": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            }
          },
          "notes": {
            "$contestantId": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            }
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "appMinClient": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber()"
    },
    "appVersions": {
      ".read": "auth != null",
      "$personId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['at'])",
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$field": {
          ".validate": "newData.isString() || newData.isBoolean() || newData.isNumber() || !newData.exists()"
        }
      }
    }
  }
}
